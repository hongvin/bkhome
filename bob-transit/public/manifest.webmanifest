{
  "id": "/",
  "name": "Klang Valley Transit Reliability",
  "short_name": "KV Transit",
  "description": "Route to arrival probability, not average duration. P90 arrival windows and risk-aware re-routing for the Klang Valley rail network — works offline in the tunnels.",
  "lang": "en-MY",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "start_url": "/",
  "scope": "/",
  "theme_color": "#0b0f14",
  "background_color": "#0b0f14",
  "categories": ["travel", "navigation", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
